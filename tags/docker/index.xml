&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl">EXPOSE 8000
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl">
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"># 启动命令
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl">CMD [&amp;#34;python&amp;#34;, &amp;#34;app.py&amp;#34;]
&lt;/span>&lt;/span>&lt;/code>&lt;/pre>&lt;/td>&lt;/tr>&lt;/table>
&lt;/div>
&lt;/div>&lt;h2 id="3-docker-compose-示例">3. Docker Compose 示例&lt;/h2>
